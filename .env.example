# Copy to .env, mode 600, then fill in real values. Never commit .env.

# Required - Home Assistant long-lived access token. The watchlist run reads the
# watchlist and pushes the summary with it; the deal service writes the to-do lists.
HA_TOKEN=changeme

# Required - postal code to search Marktguru offers for.
DEAL_SCRAPER_PLZ=changeme

# Required - name of the Home Assistant notify.* service to push the summary
# notification to, without the "notify." prefix (e.g. mobile_app_your_phone).
NOTIFY_SERVICE=changeme

# Required for `deals serve` only - the bearer token every /api and /mcp request
# must carry, at least 32 characters, e.g. from `openssl rand -hex 32`. The
# service refuses to start without it.
DEAL_SERVICE_TOKEN=changeme

# Optional - override only if your setup differs from the defaults below.
#HA_URL=http://localhost:8123
#TODO_ENTITY_ID=todo.lebensmittel_prospekt_tracker
#ANGEBOTE_ENTITY_ID=todo.aktuelle_angebote
#SHOPPING_LIST_ENTITY_ID=todo.mealie_lebensmittel
#DB_PATH=/data/deal-scraper.db
#DASHBOARD_PATH=/lovelace/deal-scraper
#DEAL_TZ=Europe/Berlin
